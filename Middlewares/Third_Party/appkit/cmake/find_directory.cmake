function(recurse_find_include_directory root out_var)
    message(DEBUG "Including directory: ${root}")
    set(result "${root}")

    file(GLOB children RELATIVE "${root}" "${root}/*")
    foreach(child ${children})
        set(child_path "${root}/${child}")
        if(IS_DIRECTORY "${child_path}")
            if(EXISTS "${child_path}/CMakeLists.txt")
                message(DEBUG "Subdirectory: ${child_path}")
                add_subdirectory("${child_path}")
            else()
                recurse_find_include_directory("${child_path}" child_result)
                list(APPEND result ${child_result})
            endif()
        endif()
    endforeach()

    set(${out_var} ${result} PARENT_SCOPE)
endfunction()
